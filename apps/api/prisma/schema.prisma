// Entidades entram por marco; este arquivo cresce junto (1a: User e Session; 1b: Area e Activity; 1c: Block e BlockException; 1d: Completion, XpTransaction e AreaProgress).
// Prisma 7: a URL do banco NÃO fica aqui, e sim em prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  // Permite relationLoadStrategy: "join" (relações resolvidas num único SELECT).
  previewFeatures     = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7))
  name         String
  email        String   @unique
  passwordHash String
  timezone     String   @default("America/Sao_Paulo")
  // Emblema escolhido pela pessoa (RF04). Chave de uma lista fixa em @lifexp/shared.
  avatarKey    String   @default("swords")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions   Session[]
  areas      Area[]
  activities Activity[]
  blocks     Block[]

  // Cache do XP total (derivado do livro-caixa XpTransaction, RN29).
  cachedTotalXp Int @default(0)

  completions    Completion[]
  xpTransactions XpTransaction[]
  areaProgress   AreaProgress[]
  goals          Goal[]
  events         CalendarEvent[]

  notifications          Notification[]
  notificationPreference NotificationPreference?

  passwordResetTokens PasswordResetToken[]
  weeklyReviews       WeeklyReview[]
  notes               Note[]
  weeklyQuests        WeeklyQuest[]
  achievements        Achievement[]
  rewards             Reward[]
  pushSubscriptions   PushSubscription[]
}

// Uma linha por refresh token emitido. A rotação cria uma nova linha na mesma tokenFamily
// e revoga a anterior; reuso de um token revogado revoga a família inteira (RS04).
model Session {
  id               String    @id @default(uuid(7))
  userId           String
  refreshTokenHash String    @unique
  tokenFamily      String
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
}

// Área da vida = atributo do personagem. Cor e ícone são chaves de listas fixas em @lifexp/shared.
// Nunca é apagada: arquivar preserva o histórico (RN27).
model Area {
  id         String    @id @default(uuid(7))
  userId     String
  name       String
  color      String
  icon       String
  position   Int
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities     Activity[]
  progress       AreaProgress?
  xpTransactions XpTransaction[]
  goals          Goal[]
  events         CalendarEvent[]
  linkedNotes    Note[]

  @@index([userId])
}

// userId repetido de propósito: toda consulta filtra pelo dono sem precisar de join (RS06).
// O service garante que userId da atividade é o mesmo userId da área.
model Activity {
  id         String    @id @default(uuid(7))
  userId     String
  areaId     String
  name       String
  xpWeight   Float     @default(1.0)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  area   Area    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  blocks Block[]

  @@index([userId])
  @@index([areaId])
}

enum BlockRecurrence {
  WEEKLY
  ONCE
}

enum ExceptionType {
  SKIP
  OVERRIDE
}

// Template de bloco (RN31): a recorrência é uma regra, não uma lista de datas futuras.
// Datas civis são DATE (sem fuso, RN36) e o horário é hora de relógio "HH:mm" (RN37): o instante
// real só é calculado na consulta, no fuso da pessoa, então trocar de fuso preserva o horário local.
// As coerências de cada campo também são garantidas por CHECK no banco (veja a migration).
model Block {
  id          String          @id @default(uuid(7))
  userId      String
  activityId  String
  recurrence  BlockRecurrence
  weekday     Int? // 1 = segunda ... 7 = domingo (só WEEKLY)
  date        DateTime?       @db.Date // só ONCE
  startTime   String // "HH:mm"
  durationMin Int
  validFrom   DateTime?       @db.Date // só WEEKLY: primeira data em que a regra vale
  validUntil  DateTime?       @db.Date // só WEEKLY: última data em que a regra vale (nulo = sem fim)
  note        String? // anotação livre da pessoa (1 a 500 caracteres; nulo = sem anotação), igual em toda a série
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity    Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  exceptions  BlockException[]
  completions Completion[]
  linkedNotes Note[]

  // Meta a que o bloco serve (RF19). Excluir a meta só solta o vínculo, o bloco continua.
  goalId String?
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([goalId])
  @@index([userId, recurrence, validFrom])
  @@index([userId, date])
  @@index([activityId])
}

// Exceção por data: pular (SKIP) ou alterar só aquela ocorrência (OVERRIDE; mover = newDate).
// Única por (blockId, occurrenceDate), conforme RN32.
model BlockException {
  id             String        @id @default(uuid(7))
  blockId        String
  occurrenceDate DateTime      @db.Date
  type           ExceptionType
  newDate        DateTime?     @db.Date
  newStartTime   String?
  newDurationMin Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, occurrenceDate])
}

enum XpTransactionType {
  COMPLETION // conclusão de bloco
  MILESTONE // marco de meta concluído (RN21)
  GOAL // meta concluída (RN21)
  QUEST // bônus da quest semanal (RN17)
  REVERSAL
}

// Uma ocorrência concluída (RN07, RN32: única por bloco + data). Desfazer NÃO apaga a linha: marca
// `undoneAt` e cria um estorno no livro-caixa; concluir de novo reaproveita a mesma linha.
// Guarda uma "foto" da atividade, da área, da duração e do XP no momento (o histórico não muda se
// o bloco ou a atividade forem editados depois).
// Sem onDelete explícito no bloco (NoAction): não dá para apagar um bloco que tem conclusões, mas
// apagar a pessoa leva tudo junto (o NoAction só é verificado no fim do comando).
model Completion {
  id             String    @id @default(uuid(7))
  userId         String
  blockId        String
  occurrenceDate DateTime  @db.Date
  completedAt    DateTime
  undoneAt       DateTime?
  activityId     String
  areaId         String
  durationMin    Int
  xpAmount       Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  block Block @relation(fields: [blockId], references: [id], onDelete: NoAction)

  @@unique([blockId, occurrenceDate])
  @@index([userId, completedAt])
}

// Livro-caixa de XP (RN29): imutável e a fonte da verdade. cachedTotalXp e AreaProgress são caches
// que podem ser reconstruídos somando estes lançamentos. Estorno = valor negativo ligado ao original;
// cada lançamento só pode ser estornado uma vez (reversedTransactionId é único).
model XpTransaction {
  id                    String            @id @default(uuid(7))
  userId                String
  areaId                String?
  amount                Int
  type                  XpTransactionType
  sourceId              String? // id da origem: Completion, Milestone ou Goal, conforme o tipo
  reversedTransactionId String?           @unique
  createdAt             DateTime          @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  area     Area?          @relation(fields: [areaId], references: [id], onDelete: NoAction)
  reversed XpTransaction? @relation("Reversal", fields: [reversedTransactionId], references: [id], onDelete: NoAction)
  reversal XpTransaction? @relation("Reversal")

  @@index([userId, createdAt])
  @@index([areaId])
}

// Cache de XP e nível por área (1:1 com Area), derivado do livro-caixa.
model AreaProgress {
  id          String   @id @default(uuid(7))
  userId      String
  areaId      String   @unique
  cachedXp    Int      @default(0)
  cachedLevel Int      @default(1)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ABANDONED
}

model Goal {
  id           String     @id @default(uuid(7))
  userId       String
  areaId       String?
  title        String
  description  String?
  deadline     DateTime?  @db.Date // data civil (RN36)
  status       GoalStatus @default(ACTIVE)
  // Métrica opcional (RF28): só faz sentido com valor-alvo.
  unit         String?
  targetValue  Float?
  currentValue Float?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  milestones  Milestone[]
  blocks      Block[]
  linkedNotes Note[]

  @@index([userId, status])
  @@index([areaId])
}

model Milestone {
  id        String    @id @default(uuid(7))
  goalId    String
  title     String
  done      Boolean   @default(false)
  doneAt    DateTime?
  position  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, position])
}

// Evento do calendário (RF33): algo que acontece numa data. Não gera XP (RN23) nem entra no streak.
model CalendarEvent {
  id              String   @id @default(uuid(7))
  userId          String
  areaId          String?
  title           String
  notes           String?
  date            DateTime @db.Date // data civil (RN36)
  time            String? // "HH:mm" no fuso da pessoa (RN37); nulo = dia todo
  // appointment | birthday | medical | trip | deadline | other (CHECK no banco)
  category        String
  // Antecedência do lembrete em minutos (RF36); nulo = sem lembrete. Quem dispara é o Marco 2c.
  remindBeforeMin Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  area        Area?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  linkedNotes Note[]

  @@index([userId, date])
  @@index([areaId])
}

enum NotificationKind {
  BLOCK // lembrete de bloco
  EVENT // lembrete de evento
  DIGEST // resumo do dia
  REPORT // relatório semanal pronto
}

// Central de avisos (RF37, RF38). Uma linha por aviso gerado pela varredura.
model Notification {
  id             String           @id @default(uuid(7))
  userId         String
  kind           NotificationKind
  title          String
  body           String
  // Quando o aviso deveria sair (o instante do lembrete). createdAt é quando foi gerado.
  scheduledFor   DateTime
  // Chave lógica única por pessoa (RF55, RN25): a mesma chave nunca gera dois avisos,
  // mesmo que a varredura rode duas vezes ou em duas instâncias.
  dedupeKey      String
  // Origem, só para abrir o item certo. Sem chave estrangeira: o aviso sobrevive à exclusão dela.
  blockId        String?
  occurrenceDate DateTime?        @db.Date
  eventId        String?
  readAt         DateTime?
  // Só o resumo (DIGEST) vai por e-mail (RF39): quando foi enviado e quantas tentativas houve.
  emailSentAt    DateTime?
  emailAttempts  Int              @default(0)
  // Push no celular (RF41): quando saiu para os aparelhos e quantas tentativas houve (como no e-mail).
  pushSentAt     DateTime?
  pushAttempts   Int              @default(0)
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// Preferências de notificação (RF40), 1:1 com a pessoa. Sem linha = padrões; a linha nasce no 1º PUT.
model NotificationPreference {
  id                    String   @id @default(uuid(7))
  userId                String   @unique
  blockRemindersEnabled Boolean  @default(true)
  // Antecedência do lembrete de bloco em minutos (RN24: padrão 15).
  blockLeadMin          Int      @default(15)
  eventRemindersEnabled Boolean  @default(true)
  digestEnabled         Boolean  @default(true)
  // Hora de relógio, no fuso da pessoa, em que o resumo do dia sai.
  digestTime            String   @default("07:00")
  digestEmailEnabled    Boolean  @default(false)
  // Aviso de relatório semanal pronto (RF47) e push no celular (RF41, desligado até a pessoa pedir).
  weeklyReportEnabled   Boolean  @default(true)
  pushEnabled           Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Token de recuperação de senha (RF05, RS12): uso único e validade curta. Como no refresh token, o
// banco guarda só o SHA-256; o token em si vai uma única vez no link do e-mail.
// createdAt e expiresAt vêm do relógio da aplicação (Clock), não do banco.
model PasswordResetToken {
  id        String    @id @default(uuid(7))
  userId    String
  tokenHash String    @unique
  createdAt DateTime
  expiresAt DateTime
  // Preenchido ao redefinir a senha, ou quando um pedido mais novo invalida este.
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Revisão semanal guiada (RF46): a reflexão da semana. Uma por pessoa e semana (a segunda-feira, DATE civil).
// O resumo de aderência NÃO é gravado: é calculado na leitura a partir de blocos e conclusões, então nunca fica velho.
// createdAt e updatedAt vêm do relógio da aplicação (Clock), como no resto do app.
model WeeklyReview {
  id           String   @id @default(uuid(7))
  userId       String
  weekStart    DateTime @db.Date
  wins         String   @default("")
  blockers     String   @default("")
  nextPriority String   @default("")
  createdAt    DateTime
  updatedAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

// Nota em markdown (RF42 a RF45). O texto é guardado como veio: a sanitização acontece na renderização (RS10).
// Tags já normalizadas pela aplicação (minúsculas, sem repetir). No máximo UM vínculo opcional; se o alvo for
// excluído, a nota fica solta (SetNull), nunca some junto. createdAt e updatedAt vêm do Clock.
model Note {
  id        String   @id @default(uuid(7))
  userId    String
  title     String
  content   String   @default("")
  pinned    Boolean  @default(false)
  tags      String[] @default([])
  areaId    String?
  blockId   String?
  goalId    String?
  eventId   String?
  createdAt DateTime
  updatedAt DateTime

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  area  Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  block Block?         @relation(fields: [blockId], references: [id], onDelete: SetNull)
  goal  Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  event CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // A lista é ordenada por fixadas e depois pelas alteradas mais recentemente (cursor por esses três campos).
  @@index([userId, pinned, updatedAt, id])
  @@index([tags], type: Gin)
  @@index([areaId])
  @@index([blockId])
  @@index([goalId])
  @@index([eventId])
}

enum QuestStatus {
  ACTIVE
  COMPLETED
}

// Quest semanal (RF22). Nasce no começo da semana com um SNAPSHOT dos blocos planejados (QuestItem): é isso que
// mantém a meta estável (RN18: blocos criados depois não entram). Uma por pessoa e semana (segunda-feira, DATE).
// O progresso NÃO é gravado: sai das conclusões ativas a cada leitura. Só o estado "cumprida" e o bônus ficam
// no livro-caixa (XpTransaction QUEST). createdAt e completedAt vêm do Clock.
model WeeklyQuest {
  id          String      @id @default(uuid(7))
  userId      String
  weekStart   DateTime    @db.Date
  status      QuestStatus @default(ACTIVE)
  createdAt   DateTime
  completedAt DateTime?

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items QuestItem[]

  @@unique([userId, weekStart])
}

// Uma ocorrência do snapshot. Identidade = bloco + data ORIGINAL (RN32). Sem chave estrangeira no bloco: o
// bloco pode ser excluído depois e o snapshot da semana continua sendo o que era.
model QuestItem {
  id             String   @id @default(uuid(7))
  questId        String
  blockId        String
  occurrenceDate DateTime @db.Date
  durationMin    Int
  // XP previsto quando o snapshot foi tirado (base do bônus de 20%).
  xp             Int

  quest WeeklyQuest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([questId, blockId, occurrenceDate])
}

// Conquistas desbloqueadas (RF23). O catálogo vive no código (@lifexp/shared); aqui só se guarda o que a pessoa já
// desbloqueou, e é permanente. `key` é texto (CHECK na migration) para ser igual ao do catálogo, sem camada de tradução.
model Achievement {
  id         String   @id @default(uuid(7))
  userId     String
  key        String
  unlockedAt DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

enum RewardTrigger {
  LEVEL
  STREAK
  TOTAL_XP
  ACHIEVEMENT
}

// Recompensa real cadastrada pela pessoa (RF25): um prêmio que ela mesma se dá ao atingir o gatilho. `reachedAt` grava
// o momento em que o gatilho foi atingido (e fica, mesmo que o streak caia depois); o resgate é uma decisão manual.
model Reward {
  id             String        @id @default(uuid(7))
  userId         String
  title          String
  description    String?
  trigger        RewardTrigger
  // Para LEVEL, STREAK e TOTAL_XP; nula em ACHIEVEMENT.
  threshold      Int?
  // Só em ACHIEVEMENT.
  achievementKey String?
  reachedAt      DateTime?
  redeemedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Aparelho inscrito para receber push (RF41). O `endpoint` identifica o navegador/aparelho e é único: o mesmo aparelho
// que entra em outra conta passa a pertencer a ela. As chaves criptografam a mensagem e são segredo do aparelho.
// Inscrição que o serviço de push recusa (404/410) é apagada.
model PushSubscription {
  id        String   @id @default(uuid(7))
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
