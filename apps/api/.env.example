NODE_ENV=development
PORT=3000
# Use a mesma senha do .env da raiz (POSTGRES_PASSWORD).
DATABASE_URL=postgresql://lifexp:change-me@localhost:5433/lifexp?schema=public
# Segredo do JWT: gere com `openssl rand -hex 32`. Mínimo de 32 caracteres.
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
# Access token curto (RS02) e refresh de 7 dias (RS03).
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# true em produção (cookie só trafega em HTTPS).
COOKIE_SECURE=false
# Limite de tentativas por IP em login, cadastro e recuperação de senha (RS08).
AUTH_RATE_LIMIT_PER_MINUTE=10
# true quando a API está atrás de proxy (Vercel/Railway).
TRUST_PROXY=false
# Varredura por minuto que gera lembretes e o resumo do dia (RN38).
NOTIFICATIONS_SCHEDULER=true
# Cria o snapshot da quest semanal na virada da semana (RN16).
QUESTS_SCHEDULER=true
# E-mail do resumo diário (RF39) e da recuperação de senha (RF05). Sem a chave, o envio só aparece
# no log; com NODE_ENV=development o log traz também o corpo (é como abrir o link de recuperação em dev).
# Crie a chave em https://resend.com e NÃO a versione.
# RESEND_API_KEY=
MAIL_FROM="LifeXP <nao-responda@seudominio.com>"
# Endereço do app, usado no link do e-mail.
APP_URL=http://localhost:5173
