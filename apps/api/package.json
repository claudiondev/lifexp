{
  "name": "@lifexp/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run --coverage && vitest run --config vitest.config.e2e.ts",
    "test:unit": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "mail:test": "node --env-file=.env scripts/send-test-email.mjs",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "perf:smoke": "node --env-file=.env scripts/perf-smoke.mjs"
  },
  "dependencies": {
    "@lifexp/shared": "workspace:^",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "helmet": "^8.3.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "prisma": "7",
    "supertest": "^7.3.0",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
